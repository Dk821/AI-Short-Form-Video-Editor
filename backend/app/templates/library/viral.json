{
  "id": "viral",
  "name": "Viral",
  "category": "Viral",
  "description": "Big punchy single words, high-contrast yellow, built to stop the scroll.",
  "tags": ["high-energy", "hook-first"],
  "aspectRatio": "9:16",
  "accentColor": "#FDE047",
  "thumbnailUrl": "/api/templates/thumbnails/viral.jpg",
  "caption": {
    "fontFamily": "Space Grotesk",
    "fontSize": 96,
    "fontWeight": 800,
    "color": "#FDE047",
    "highlightColor": "#FFFFFF",
    "emphasisColor": "#FFFFFF",
    "strokeColor": "#000000",
    "strokeWidth": 3,
    "position": "center",
    "alignment": "center",
    "animation": "pop",
    "wordsPerCaption": 1,
    "case": "upper"
  },
  "broll": {
    "enabled": true,
    "position": "center",
    "layout": "full",
    "defaultScale": 0.6,
    "transitionMs": 150,
    "frequency": "high",
    "revealAnimation": "bounce_in",
    "revealDuration": 0.45
  },
  "overlay": {
    "enabled": false,
    "hookText": "You won't believe this..."
  },
  "zoom": {
    "enabled": true,
    "minScale": 1.25,
    "maxScale": 1.5,
    "duration": 0.5,
    "easing": "ease-out",
    "triggerRules": ["emphasis", "punchline"]
  },
  "transition": {
    "enabled": true,
    "availableTypes": ["zoom", "slide"],
    "duration": 0.25,
    "easing": "ease-out",
    "sceneChangeBehavior": "auto"
  },
  "audio": {
    "musicVolume": 0.3,
    "sfxVolume": 0.85,
    "ducking": true,
    "duckingLevel": 0.2
  }
}
