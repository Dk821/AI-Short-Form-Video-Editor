{
  "id": "bold-viral-01",
  "name": "Bold Viral",
  "category": "Viral",
  "description": "Big single-word punch captions with a bold orange highlight — built to stop the scroll.",
  "tags": ["high-energy", "hook-first"],
  "aspectRatio": "9:16",
  "accentColor": "#FF6B00",
  "thumbnailUrl": "/api/templates/thumbnails/bold-viral-01.jpg",
  "overlayVideoUrl": "/api/templates/overlays/bold-viral-01.mp4",

  "caption": {
    "fontFamily": "Montserrat",
    "fontSize": 64,
    "fontWeight": 800,
    "color": "#FFFFFF",
    "highlightColor": "#FF6B00",
    "emphasisColor": "#FF6B00",
    "strokeColor": "#000000",
    "strokeWidth": 3,
    "position": "center",
    "alignment": "center",
    "animation": "word_by_word",
    "wordsPerCaption": 1,
    "case": "upper"
  },

  "broll": {
    "enabled": true,
    "position": "full-screen",
    "layout": "full",
    "defaultScale": 1.0,
    "transitionMs": 250,
    "frequency": "high",
    "revealAnimation": "zoom_in",
    "revealDuration": 0.4,
    "maxDuration": 5.0,
    "cooldown": 2.0
  },

  "overlay": {
    "enabled": true,
    "blendMode": "screen",
    "opacity": 0.85,
    "hookText": "Wait for it...",
    "watermarkPosition": "bottom-right"
  },

  "zoom": {
    "enabled": true,
    "minScale": 1.2,
    "maxScale": 1.6,
    "duration": 0.5,
    "easing": "ease-out",
    "triggerRules": ["emphasis", "punchline", "question"]
  },

  "transition": {
    "enabled": true,
    "availableTypes": ["zoom", "fade"],
    "duration": 0.3,
    "easing": "ease-out",
    "sceneChangeBehavior": "auto"
  },

  "audio": {
    "musicVolume": 0.25,
    "sfxVolume": 0.9,
    "ducking": true,
    "duckingLevel": 0.15
  }
}
