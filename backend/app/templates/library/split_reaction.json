    "maxScale": 1.0,
    "duration": 0.5,
    "easing": "ease-out",
    "triggerRules": []
  },
  "transition": {
    "enabled": true,
    "availableTypes": ["slide", "wipe"],
    "duration": 0.3,
    "easing": "ease-out",
    "sceneChangeBehavior": "auto"
  },
  "audio": {
    "musicVolume": 0.25,
    "sfxVolume": 0.8,
    "ducking": true,
    "duckingLevel": 0.2
