  "tags": ["duet", "split-screen", "reaction"],
  "aspectRatio": "9:16",
  "accentColor": "#EC4899",
  "thumbnailUrl": "/api/templates/thumbnails/split_reaction.jpg",
  "overlayVideoUrl": "/api/templates/overlays/split_reaction.mp4",
  "caption": {
    "fontFamily": "Space Grotesk",
    "fontSize": 72,
    "fontWeight": 800,
    "color": "#FFFFFF",
    "highlightColor": "#EC4899",
    "emphasisColor": "#EC4899",
    "strokeColor": "#000000",
    "strokeWidth": 3,
    "position": "bottom",
    "alignment": "center",
    "animation": "pop",
    "wordsPerCaption": 3,
